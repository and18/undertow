# Varnish build with parametric support for VARNISH_SIZE and VARNISH_BACKEND.
#
# Accepts environment variables:
#   VARNISH_SIZE    Cache size (default: 256m)
#   VARNISH_BACKEND Backend as host:port (default: app:8000)
#
# Generates default.vcl from the template and starts varnishd.

FROM varnish:7.5

RUN apt-get update && apt-get install -y --no-install-recommends \
    gettext-base \
    && rm -rf /var/lib/apt/lists/*

COPY default.vcl.tpl /tmp/default.vcl.tpl
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
