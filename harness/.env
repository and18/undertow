# harness/.env
#
# Parametri di sweep e ripartizione delle CPU.
# Ogni run deve registrare questo file per intero: senza, il risultato
# non e' riproducibile.

# --- ripartizione CPU ----------------------------------------------------
# Il generatore NON deve mai condividere core con il bersaglio, altrimenti
# gli ruba risorse proprio quando il sistema satura e i numeri diventano
# inservibili. Adattare su macchine con meno di 8 core.
CPUSET_K6=0,1,2,3          # generatore: 4 core
CPUSET_VARNISH=4,5,6,7     # cache: 4 core, non deve mai essere il limite
CPUSET_APP=8,9             # app: 2 core
CPUSET_DB=10,11            # db: 2 core
CPUSET_OBS=14,15           # osservazione

# --- risorse limitate: le variabili di sweep -----------------------------
# THREADS e' il pool di thread dell'application server, analogo a un
# Work Manager WebLogic. E' la risorsa la cui saturazione si vuole
# misurare. Lo sweep principale la tiene fissa e varia la frazione di
# traffico agentico; uno sweep secondario la varia per verificare che il
# ginocchio cada sempre alla stessa FRAZIONE di occupazione, non allo
# stesso valore assoluto.
THREADS=16
BACKLOG=128

DB_POOL_MIN=2
DB_POOL_MAX=16

# --- cache ---------------------------------------------------------------
# La cache deve essere PIU' PICCOLA del working set, altrimenti non c'e'
# competizione e il fenomeno non si manifesta. Rapporti tipici in
# produzione: 1-10%. Qui si parte dal 10% e la frazione e' essa stessa
# una variabile di sweep.
VARNISH_SIZE=2m
CACHE_TTL=3600

# --- generatore ----------------------------------------------------------
TARGET=http://varnish:80

