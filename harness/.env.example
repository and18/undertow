# harness/.env.example
#
# Credentials for the local containers. They are not versioned: append this
# file to the per-host configuration and set your own values.
#
#   cp env.arm6 .env              # or env.x86-16, or your own
#   cat .env.example >> .env
#   $EDITOR .env                  # fill in the two values below
#
# docker compose refuses to start while either value is missing.
# The stack listens on localhost only and holds no personal data; these
# passwords protect the database and Grafana from other users of the host.

# PostgreSQL (user and database are both "undertow"), used by the app,
# the corpus loader and the PostgreSQL exporter.
POSTGRES_PASSWORD=

# Grafana admin password, also used by the load scripts to write annotations.
GRAFANA_ADMIN_PASSWORD=
