# Assegnazione CPU su 6 core fisici Ampere (Neoverse-N1, nessun SMT).
# Database e generatore hanno due core ciascuno: sono i due componenti
# che, saturando, misurerebbero se stessi invece del fenomeno.
# Osservabilita condivide con il generatore, che a questi ritmi usa una
# frazione di un core.
CPUSET_K6=0
CPUSET_VARNISH=1
CPUSET_APP=2
CPUSET_DB=3,4,5
CPUSET_OBS=0

# Invariati rispetto al Lenovo, per comparabilita dei risultati
# normalizzati. Il GIL rende inutile piu di un core per l'applicazione,
# quindi passare da due core a uno non dovrebbe cambiare nulla:
# verificarlo fa parte del test di invarianza fra x86 e ARM.
THREADS=8
BACKLOG=128
DB_POOL_MIN=2
DB_POOL_MAX=12
VARNISH_SIZE=128m
CACHE_TTL=3600
TARGET=http://varnish:80

# Budget disattivato: configurazione di riferimento.
BUDGET_LOW=0
BUDGET_WAIT=0
