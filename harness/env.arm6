# CPU assignment on 6 physical Ampere cores (Neoverse-N1, no SMT).
# The database and the generator get two cores each: they are the two
# components that, once saturated, would measure themselves instead of
# the phenomenon. Observability shares a core with the generator, which
# at these rates uses a fraction of a core.
CPUSET_K6=0
CPUSET_VARNISH=1
CPUSET_APP=2
CPUSET_DB=3,4,5
CPUSET_OBS=0

# Unchanged from the Lenovo, so that normalised results stay comparable.
# The GIL makes more than one core useless for the application, so going
# from two cores to one should change nothing: checking this is part of
# the invariance test between x86 and ARM.
THREADS=8
BACKLOG=128
DB_POOL_MIN=2
DB_POOL_MAX=12
VARNISH_SIZE=128m
CACHE_TTL=3600
TARGET=http://varnish:80

# Budget disabled: reference configuration.
BUDGET_LOW=0
BUDGET_WAIT=0
