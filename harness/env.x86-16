# harness/.env
#
# Sweep parameters and CPU partitioning.
# Every run must record this file in full: without it, the result is
# not reproducible.

# --- CPU partitioning ----------------------------------------------------
# The generator must NEVER share cores with the target, otherwise it
# steals resources exactly when the system saturates and the numbers
# become useless. Adapt on machines with fewer than 8 cores.
CPUSET_K6=0,1,2,3          # generator: 4 cores
CPUSET_VARNISH=4,5,6,7     # cache: 4 cores, must never be the limit
CPUSET_APP=8,9             # app: 2 cores
CPUSET_DB=10,11            # db: 2 cores
CPUSET_OBS=14,15           # observation

# --- limited resources: the sweep variables ------------------------------
# THREADS is the application server's thread pool, analogous to a
# WebLogic Work Manager. It is the resource whose saturation we want to
# measure. The main sweep keeps it fixed and varies the fraction of
# agentic traffic; a secondary sweep varies it to check that the knee
# always falls at the same FRACTION of occupancy, not at the same
# absolute value.
THREADS=8
BACKLOG=128

DB_POOL_MIN=2
DB_POOL_MAX=12

# --- cache ---------------------------------------------------------------
# The cache must be SMALLER than the working set, otherwise there is no
# competition and the phenomenon does not appear. Typical production
# ratios: 1-10%. Here we start from 10% and the fraction is itself a
# sweep variable.
VARNISH_SIZE=128m
CACHE_TTL=3600

# --- generator -----------------------------------------------------------
TARGET=http://varnish:80

BUDGET_WAIT=0
BUDGET_LOW=0
