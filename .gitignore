# Contenuto generato — si rigenera, non si versiona
site/
cache/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Dati sperimentali (grandi; archiviati altrove)
data/raw/
data/parquet/
*.parquet
*.hdr
# Log dell'honeypot: contengono IP in chiaro. Mai nel repository.
data/hplogs/

# Risultati sperimentali: rigenerabili, non versionati
harness/results/

# Log
*.log
logs/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Segreti — non devono mai finire nel repo
*.pem
*.key
.env
.env.*
oci_api_key*
OCI/
# Template of the credentials, without values: versioned
!harness/.env.example

# Configurazioni per macchina: ogni host copia la propria in .env,
# che resta ignorato. Senza questi file nessuna campagna e' riproducibile.
!harness/env.*

# Generato da split.sh a ogni configurazione
harness/nginx/router.active.conf

# Immagini: di norma no, tranne quelle del progetto
*.png
!docs/**/*.png
!figures/**/*.png
# ...ma non le prove di QA, che si rigenerano a ogni build
figures/_qa/

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.out
paper/*.toc
paper/main.pdf

# Not published: working notes, assistant configuration, the honeypot's
# IndexNow key (served by the site, not by the repository), and the narrow
# figures (regenerated by make figures, not used by the paper)
CLAUDE.md
.claude/
docs/recap/
honeypot/static/989bd4b93d864525a40b9b19bc590fed.txt
figures/narrow/
