# Generated content — regenerated, not versioned
site/
cache/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Experimental data (large; archived elsewhere)
data/raw/
data/parquet/
*.parquet
*.hdr
# Honeypot logs: they contain plain-text IPs. Never in the repository.
data/hplogs/

# Experimental results: regenerable, not versioned
harness/results/

# Log
*.log
logs/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Secrets — they must never end up in the repo
*.pem
*.key
.env
.env.*
oci_api_key*
OCI/
# Template of the credentials, without values: versioned
!harness/.env.example

# Per-machine configurations: each host copies its own to .env,
# which stays ignored. Without these files no campaign is reproducible.
!harness/env.*

# Generated by split.sh at every configuration
harness/nginx/router.active.conf

# Images: normally no, except the project's own
*.png
!docs/**/*.png
!figures/**/*.png
# ...but not the QA proofs, which are regenerated at every build
figures/_qa/

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.out
paper/*.toc
paper/main.pdf
# arXiv package, rebuilt by paper/make_arxiv.sh
paper/arxiv/

# Not published: working notes, assistant configuration, the honeypot's
# IndexNow key (served by the site, not by the repository), and the narrow
# figures (regenerated by make figures, not used by the paper)
CLAUDE.md
.claude/
docs/recap/
honeypot/static/989bd4b93d864525a40b9b19bc590fed.txt
figures/narrow/
figures/editorial/

# Working copy of the paper without the claims overlay, built locally
paper/main-clean.*
